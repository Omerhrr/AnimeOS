generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// PRODUCTION HIERARCHY: Project → Season → Episode → Scene → Shot
// ─────────────────────────────────────────────────────────────

model Project {
  id               String   @id @default(cuid())
  title            String
  logline          String?
  format           String   @default("SERIES") // FEATURE | SERIES | SHORT
  animationType    String   @default("3D") // 3D | 2D | HYBRID
  visualStyle      String   @default("DONGHUA") // DONGHUA | ANIME | KOREAN | WESTERN | CUSTOM
  originalLanguage String   @default("zh-CN")
  subtitleLanguages String  @default("[]") // JSON string[]
  fps              Int      @default(24)
  resolution       String   @default("1920x1080")
  // Per-production art style tuning - injected into every art prompt
  // (panel art + model sheets). Empty fields fall back to the preset
  // tokens derived from visualStyle.
  artStylePrompt    String? // custom style directive (overrides preset tokens)
  artPalettePrompt  String? // palette / colour-mood tokens
  artNegativePrompt String? // extra negative tokens appended to the negative tail
  status           String   @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  approvalGate     Boolean  @default(false) // when on, an APPROVED DSH inspection parks the render at REVIEW until a human approves
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seasons          Season[]
  loras            StyleLora[]
  trainRuns        LoraTrainRun[]
  artists          Artist[]
  characters       Character[]
  environments     Environment[]
  assets           Asset[]
  terminology      Terminology[]
  renderJobs       RenderJob[]
  productionEvents ProductionEvent[]
  continuityEvents ContinuityEvent[]
  dshMessages      DshMessage[]
  dshPlans         DshPlan[]
  arcTemplates     ArcTemplate[]
  universeFacts    UniverseFact[]
  repaintRuns      RepaintRun[]
  studioSchedules  StudioSchedule[]
  identityScores   IdentityScore[]
  panelEmbeddings  PanelEmbedding[]
  planTemplates    PlanTemplate[]
  blenderAssets    BlenderAsset[]
  comments         Comment[]
  memberships      ProjectMembership[]
}

// ─────────────────────────────────────────────────────────────
// BLENDER ASSET LIBRARY (Blender as a native capability)
//
// Design-time assets the studio's own Blender runtime produces and
// version: DESIGNED characters and environments as real .blend
// files with a turntable preview, built once by the DSH designer
// loop and consumed by every render job afterwards (design once,
// render many). The render worker loads these instead of rebuilding
// the procedural stand-ins; a missing file falls back honestly.
// ─────────────────────────────────────────────────────────────
model BlenderAsset {
  id            String   @id @default(cuid())
  projectId     String
  kind          String   // CHARACTER | ENVIRONMENT
  refName       String   // the character's or environment's exact name
  status        String   @default("DRAFT") // DRAFT | BUILDING | READY | FAILED
  version       Int      @default(0) // bumped on every accepted build
  blendPath     String?  // assets/blender/... the accepted .blend
  previewPath   String?  // the turntable preview png (served from /assets-blender/)
  buildLog      String?  // tail of the last build attempt's output
  designSource  String?  // the design text the asset was built from (audit)
  identityScore Float?   // latest vision score of the preview vs the model sheet (0..1)
  inspectNote   String?  // the vision model's note on the asset preview
  inspectedAt   DateTime?
  meta          String?  // JSON {dna, objects, polyCount, buildMs, ...}
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, refName])
}

model Season {
  id        String    @id @default(cuid())
  projectId String
  number    Int
  title     String
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodes  Episode[]

  @@unique([projectId, number])
}

model Episode {
  id        String   @id @default(cuid())
  seasonId  String
  number    Int
  title     String
  synopsis  String?
  status    String   @default("DRAFT") // DRAFT | IN_PRODUCTION | REVIEW | RENDERED
  createdAt DateTime @default(now())
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  scenes    Scene[]

  @@unique([seasonId, number])
}

model Environment {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?
  timeOfDay   String?
  weather     String?
  atmosphere  String? // JSON string[]
  lighting    String?
  createdAt   DateTime @default(now())
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes      Scene[]

  @@unique([projectId, name])
}

model Scene {
  id                 String   @id @default(cuid())
  episodeId          String
  number             Int
  title              String
  description        String?
  environmentId      String?
  timeOfDay          String?
  weather            String?
  atmosphere         String? // JSON string[]
  lighting           String?
  // Live render params the DSH evaluation loop can tune (bridge driver reads these)
  fogDensity         Float    @default(0.45)
  lightningIntensity Float    @default(0.55)
  energyIntensity    Float    @default(0.6)
  cameraDistance     Float    @default(1.0)
  rimLightIntensity  Float    @default(0.5)
  status             String   @default("DRAFT") // DRAFT | BUILDING | PREVIEW | REVIEW | APPROVED | RENDERED
  createdAt          DateTime @default(now())
  episode            Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  environment        Environment? @relation(fields: [environmentId], references: [id])
  shots              Shot[]

  @@unique([episodeId, number])
}

model Shot {
  id          String   @id @default(cuid())
  sceneId     String
  number      Int
  description String
  shotType    String   @default("MEDIUM") // ESTABLISHING | WIDE | MEDIUM | CLOSEUP | EXTREME_CLOSEUP | LOW_ANGLE
  lens        String?  // e.g. "50mm"
  movement    String?  // ORBIT | DOLLY_IN | STATIC | PAN | TRACKING | CRANE
  poseStart   String?  // character start pose (see src/lib/animation/poses.ts)
  poseEnd     String?  // character end pose - drivers interpolate start -> end across the clip
  duration    Float    @default(4.0)
  lighting    String?
  status      String   @default("DRAFT") // DRAFT | QUEUED | RENDERING | REVIEW | APPROVED | FINAL | FAILED
  artworkUrl  String?  // AI-generated panel art (served from /panels/)
  artGeneratedAt DateTime? // when the current artworkUrl was generated - art-aware continuity compares this against state/anchor timestamps
  dialogue    String?  // JSON: Array<{ speaker, text, kind: SPEECH | THOUGHT | SFX }>
  // Per-shot style LoRA fine-tuning - selects a production LoRA adapter
  // whose trigger tokens are injected into this shot's art prompt.
  loraId      String?
  loraStrength Float?  // 0.1-1.2, falls back to the LoRA's default weight
  // Multi-artist workflow - which artist owns this panel
  artistId    String?
  createdAt   DateTime @default(now())
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  renderJobs  RenderJob[]
  lora        StyleLora? @relation(fields: [loraId], references: [id], onDelete: SetNull)
  artist      Artist?    @relation(fields: [artistId], references: [id], onDelete: SetNull)
  audioCues   AudioCue[]
  identityScores IdentityScore[]
  panelEmbedding PanelEmbedding?

  @@unique([sceneId, number])
}

// ─────────────────────────────────────────────────────────────
// STYLE LORA REGISTRY + ARTIST ROSTER + SOUND DESIGN
// ─────────────────────────────────────────────────────────────

// A style LoRA adapter registered for a production. Trigger tokens
// + strength flow into the art prompt of any shot assigned to it -
// per-shot style fine-tuning on top of the production style.
model StyleLora {
  id            String   @id @default(cuid())
  projectId     String
  name          String
  triggerPhrase String   // comma/space-separated trigger tokens injected verbatim
  weight        Float    @default(0.8) // default strength for shots without an explicit one
  baseModel     String?  // e.g. "SDXL", "FLUX.1", "animagine-xl"
  notes         String?
  // Simulated fine-tune runs distilled from the production's approved panels
  status        String   @default("READY") // READY | TRAINING | FAILED
  trainProgress Float    @default(1)      // 0..1 while TRAINING, 1 when READY
  trainedPanels Int?     // dataset size of the last completed run
  trainedAt     DateTime?
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots         Shot[]
  trainRuns     LoraTrainRun[]

  @@unique([projectId, name])
}

// One simulated LoRA fine-tune run over a panel dataset. Progress is
// advanced by tickLoraTrainRuns on GET polls (same pattern as render jobs).
model LoraTrainRun {
  id         String    @id @default(cuid())
  loraId     String
  projectId  String
  status     String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  progress   Float     @default(0)         // 0..1
  step       Int       @default(0)
  totalSteps Int       @default(0)
  panelCount Int       @default(0)
  lossCurve  String?   // JSON number[] sampled over training
  runLog     String?   // JSON string[] milestone messages
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  lora       StyleLora @relation(fields: [loraId], references: [id], onDelete: Cascade)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Studio roster member for multi-artist shot assignment.
// Per-artist voice casting: an artist carries a TTS voice and can be
// cast as the speaking voice of characters (Character.voiceArtist).
model Artist {
  id        String   @id @default(cuid())
  projectId String
  name      String
  role      String?  // e.g. "Key animator", "Backgrounds", "Effects"
  color     String   @default("#7c9cff")
  voiceId   String?  // TTS voice id this artist performs with
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots     Shot[]
  voiceRoles Character[] @relation("VoiceCast")
}

// Sound-design cue for a shot's motion panel: timed on the shot's
// duration timeline and previewed with the WebAudio engine.
model AudioCue {
  id         String  @id @default(cuid())
  shotId     String
  kind       String  @default("SFX") // SFX | VOICE | BGM | AMBIENCE
  label      String
  startMs    Int     @default(0)
  durationMs Int     @default(600)
  volume     Float   @default(0.8)
  // Real TTS voice render for VOICE cues (served from /voices/);
  // synthesized blip fallback applies when voiceUrl is null.
  voiceUrl         String?   // rendered take, cache-busted with ?v=
  voiceActor       String?   // TTS voice name used for the render
  voiceSpeed       Float?    // speed used for the render (0.5..2.0)
  voiceDurationMs  Int?      // actual rendered audio duration
  voiceState       String?   // delivery profile: NEUTRAL | EXCITED | INJURED
  voiceStateLabel  String?   // character state the delivery was resolved from
  voiceDelivery    String?   // standing direction: null = auto per render, else NEUTRAL | EXCITED | INJURED
  voiceNote        String?   // directorial note attached to the delivery
  voiceCast        String?   // cast artist name that performed the last take
  voiceSig         String?   // take-input snapshot at render time (JSON: text/voice/delivery/speed) - diffs re-render only takes whose inputs moved
  acousticReport   String?   // acoustic alignment audit (JSON: provider, runs, nuclei, confirmed/missing tokens, note) - the acoustic slot's persisted verdict on the take
  createdAt  DateTime @default(now())
  shot       Shot    @relation(fields: [shotId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// CHARACTER UNIVERSE (persistent entities, not just meshes)
// ─────────────────────────────────────────────────────────────

model Character {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  role           String?  // PROTAGONIST | RIVAL | MENTOR | ANTAGONIST | SUPPORTING
  age            String?
  personality    String?
  backstory      String?
  appearance     String?  // JSON {face, body, hair, skin, features}
  wardrobe       String?  // JSON [{name, slot, description}]
  abilities      String?  // JSON string[]
  animationLib   String?  // JSON string[]
  canonicalState String?  // JSON summary of current canonical condition (injuries etc.)
  modelSheetUrl   String?  // AI-generated character model sheet (served from /sheets/)
  modelSheetPrompt String? // Canonical visual-anchor prompt - reused in every panel art for consistency
  modelSheetAt    DateTime? // when the current sheet/anchor was generated - art-aware continuity staleness anchor
  parentId       String?  // derivative source character
  derivativeType String?  // CLONE | AVATAR | REINCARNATION | POSSESSION | DISGUISE | TRANSFORMATION
  // Per-artist voice casting: which roster artist speaks for this character
  voiceArtistId  String?
  voiceArtist    Artist?  @relation("VoiceCast", fields: [voiceArtistId], references: [id], onDelete: SetNull)
  // Voice-clone slot: the character's own trained voice (trained once
  // from their rendered takes through the configured cloning provider,
  // ANIMEOS_VOICE_CLONE_URL). Performed on every line it can render;
  // catalog TTS stays the honest fallback.
  cloneVoiceId   String?
  cloneTrainedAt DateTime?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         Character?  @relation("Derivatives", fields: [parentId], references: [id])
  derivatives    Character[] @relation("Derivatives")
  states         CharacterState[]
  stateAuditions StateAudition[]
  relationsFrom  Relationship[] @relation("RelFrom")
  relationsTo    Relationship[] @relation("RelTo")
}

model CharacterState {
  id            String  @id @default(cuid())
  characterId   String
  label         String
  episodeNumber Int?
  stateType     String  @default("PERMANENT") // PERMANENT | TEMPORARY | VARIANT
  cultivation   String?
  weapon        String?
  clothing      String?
  abilities     String? // JSON string[]
  voiceVariant  String? // state voice variant: TTS voice that performs the character's lines while this state is episode-effective (null = cast voice)
  poseStart     String? // state pose preset: the pose the character starts from while this state performs (see src/lib/animation/poses.ts)
  poseEnd       String? // state pose preset: the pose the state's performance moves into - development state changes HOW a pose is performed
  speedHint     Float?  // state speed hint: multiplier on the take's base speed while this state supplies the performance (1 = no bend)
  pitchHint     Float?  // state pitch hint: playback pitch factor for takes in this state (1 = natural pitch; <1 deeper, >1 higher)
  createdAt     DateTime @default(now())
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  auditions     StateAudition[]
}

// ─────────────────────────────────────────────────────────────
// PER-STATE AUDITION HISTORY
// ─────────────────────────────────────────────────────────────

// Every auditioned read of ONE development state, kept for
// comparison: a state's proposed performances were throwaway renders
// (play once, gone) - now each one lands here with its performance
// snapshot (voice, register, speed/pitch, the line it read), so the
// casting board can replay and compare every past read of a state.
// Rows are written by the DSH audition chain (variant binds +
// ensemble applies, via renderVariantAudition) and by the casting
// board's state auditions; the latest KEEP_PER_STATE per state are
// kept, older rows (and their WAV files) are pruned. Deleting a
// state deletes its history.
model StateAudition {
  id          String   @id @default(cuid())
  stateId     String
  characterId String
  projectId   String
  url         String   // rendered WAV under /auditions/, cache-busted with ?v=
  text        String   // the line that was read
  source      String   // custom | character line | sample
  voiceId     String   // TTS voice that performed the read
  deliveryId  String   // register the read was performed in
  speed       Float    // effective pace incl. state hint (1 = none)
  pitch       Float    // effective pitch factor (1 = natural)
  durationMs  Int?
  createdAt   DateTime @default(now())
  state       CharacterState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Relationship {
  id      String @id @default(cuid())
  fromId  String
  toId    String
  type    String // MASTER | RIVAL | BROTHER | ENEMY | CLONE | AVATAR | REINCARNATION | ALLY ...
  from    Character @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to      Character @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// ASSET SYSTEM with versioning
// ─────────────────────────────────────────────────────────────

model Asset {
  id             String   @id @default(cuid())
  projectId      String
  category       String   // CHARACTER | ENVIRONMENT | PROP | CREATURE | VEHICLE | EFFECT
  name           String
  description    String?
  status         String   @default("DRAFT") // DRAFT | BUILDING | REVIEW | APPROVED
  currentVersion Int      @default(1)
  linkedEntity   String?  // e.g. "character:<id>" or "environment:<id>"
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       AssetVersion[]
}

model AssetVersion {
  id        String   @id @default(cuid())
  assetId   String
  version   Int
  note      String?
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// RENDER PIPELINE + DSH EVALUATION LOOP
// ─────────────────────────────────────────────────────────────

model RenderJob {
  id         String    @id @default(cuid())
  projectId  String
  shotId     String?
  mode       String    @default("PREVIEW") // PREVIEW | FINAL
  status     String    @default("QUEUED") // QUEUED | RENDERING | REVIEW | APPROVED | NEEDS_REVISION | FAILED
  progress   Float     @default(0)
  stage      String    @default("Queued")
  attempt    Int       @default(1)
  // BLENDER (workstation bridge, animated sequence mode) | MOTION
  // (built-in ffmpeg camera-grammar engine) | SIMULATOR (wall-clock
  // fallback when neither engine exists)
  driver     String    @default("SIMULATOR")
  durationMs Int       @default(16000)
  // Finished render artifact: an animated clip (mp4) served from
  // /renders/. Still-frame outputs (legacy bridge pngs) keep this
  // null and surface the frame through the job payload instead.
  outputUrl  String?
  // IMG2VID provider task id (async video-generation model). Host
  // protocol jobs poll by AnimeOS jobId; SDK jobs poll by this id.
  providerTaskId String?
  // Speaking-closeup lip-sync note computed at submit ("audio-driven
  // lip-sync on Lin Yue (1 line, 5 visemes from 1 real take)"). Kept
  // through completion so the finished stage and queue cards keep
  // naming the performance after the poll path rewrites the stage.
  lipNote  String?
  // Per-provider telemetry recorded at completion: JSON
  // {spans: [{provider, ms, note?}], takeovers: string[], totalMs,
  // credits} - one span per provider that actually worked on the
  // job (takeovers chain spans), latency per span and an estimated
  // cost read from the documented per-provider rate table. The
  // queue cards surface it as a latency/cost readout.
  telemetry String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shot       Shot?     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  evaluation Evaluation?
}

model Evaluation {
  id          String   @id @default(cuid())
  renderJobId String   @unique
  verdict     String   // APPROVED | NEEDS_REVISION
  summary     String
  findings    String   // JSON [{aspect, status, note}]
  actions     String   // JSON [{type, target, param, from, to, reason}]
  applied     Boolean  @default(false)
  createdAt   DateTime @default(now())
  renderJob   RenderJob @relation(fields: [renderJobId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// CONTINUITY ENGINE + TRANSLATION MEMORY + HISTORY + DSH
// ─────────────────────────────────────────────────────────────

model ContinuityEvent {
  id            String   @id @default(cuid())
  projectId     String
  entityType    String   // PROP | CHARACTER | ENVIRONMENT | ABILITY
  entityName    String
  kind          String   // DESTROYED | INJURED | GAINED | LOST | TRANSFORMED | CUSTOM
  episodeNumber Int?
  description   String
  severity      String   @default("INFO") // INFO | WARNING | CRITICAL
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// UNIVERSE FACTS - the production's canon rules of the world (visual
// and narrative): glowing blade spirits, two moons over the arena, a
// masked antagonist. Vision checks compare panel art against the
// active facts and land confidence-scored verdicts; low-confidence
// violations feed the re-render queue in the Continuity view.
model UniverseFact {
  id         String   @id @default(cuid())
  projectId  String
  text       String
  category   String   @default("WORLD") // WORLD | CHARACTER | PROP | LOCATION | RULE
  source     String   @default("USER") // USER | DSH | BIBLE
  active     Boolean  @default(true) // inactive facts are skipped by vision checks
  lastRewordedFrom String? // the wording this fact replaced (set on reword, cleared after the re-audit sweep closes the loop)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Supervised auto re-paint runner: one pass over the universe-facts
// re-render queue (worst confidence first). Each step re-generates a
// flagged panel with fact-aware art prompts, re-runs the vision check
// and records the outcome; steps that come back STILL_BROKEN stop
// being retried automatically and wait for the director (supervision).
model RepaintRun {
  id        String   @id @default(cuid())
  projectId String
  status    String   @default("RUNNING") // RUNNING | PAUSED | DONE | ABORTED
  cap       Int      @default(3) // max queue items the run will visit
  index     Int      @default(0) // steps completed so far
  steps     String   @default("[]") // JSON: Array<{shotId, ref, factTexts, beforeWorst, afterSummary, afterBroken, outcome, error, at}>
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Terminology {
  id           String   @id @default(cuid())
  projectId    String
  term         String
  category     String?  // CHARACTER_NAME | TECHNIQUE | LOCATION | REALM | ORGANIZATION | ITEM
  translations String   // JSON {lang: translation}
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, term])
}

model ProductionEvent {
  id        String   @id @default(cuid())
  projectId String?
  actor     String   @default("DSH") // DSH | USER | SYSTEM
  type      String   // TOOL_CALL | RENDER | EVALUATION | CONTINUITY | PROJECT | STATE_CHANGE
  summary   String
  payload   String?  // JSON detail
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DshMessage {
  id        String   @id @default(cuid())
  projectId String
  role      String   // user | dsh
  content   String
  trace     String?  // JSON [{step, thought, plan, actions:[{tool,args,result,status}]}]
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// DSH PLANS THAT SURVIVE THE TURN (cross-turn directing)
// A plan is an ordered list of tool calls DSH lands for work that
// spans turns or days. It starts PROPOSED: the creator approves it in
// the plan review panel, and from then on run_plan executes the next
// steps (a few per call) and reports - pause/abort hold between steps.
// ─────────────────────────────────────────────────────────────
model DshPlan {
  id        String   @id @default(cuid())
  projectId String
  title     String
  goal      String   // what this plan accomplishes, in the creator's language
  status    String   @default("PROPOSED") // PROPOSED | ACTIVE | PAUSED | DONE | ABORTED
  source    String   @default("DSH") // DSH | CREATOR
  steps     String   @default("[]") // JSON: Array<{tool, args, why, status: PENDING|DONE|ERROR, result?, at?}>
  cursor    Int      @default(0) // index of the next step to run (stays AT a failed step for retry)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// CADENCE SCHEDULER (the studio runs between conversations)
// ─────────────────────────────────────────────────────────────

// A recurring job the studio performs on a cadence, without anyone
// clicking: nightly breakdowns (run an approved plan a few steps a
// night until it is DONE) and render-queue supervision (tick active
// render jobs and start a supervised re-paint pass whenever the
// universe-facts queue is dirty and no run is live). Everything a
// fire does lands as a production event, and the last status/report
// stay on the row so the creator can audit what the studio did
// overnight. nextRunAt is the single source of truth for "due": the
// engine loop (src/lib/scheduler.ts, started by instrumentation)
// fires every enabled schedule whose nextRunAt has passed, then
// advances it by the cadence.
model StudioSchedule {
  id            String    @id @default(cuid())
  projectId     String
  name          String
  kind          String    @default("PLAN_RUN") // PLAN_RUN | REPAINT_QUEUE | DAILY_DIGEST | PUBLISH_RUN
  planId        String?   // PLAN_RUN: explicit plan (null = the latest ACTIVE plan at fire time)
  publishConfig String?   // PUBLISH_RUN: JSON {episodeNumber, platform} - which episode gets staged for which platform each fire
  cadence       String    @default("DAILY") // HOURLY | DAILY | WEEKLY
  intervalHours Int       @default(1) // HOURLY: every N hours (1..24)
  hourUtc       Int       @default(2) // DAILY/WEEKLY: hour of day (0..23), studio-night default
  weekday       Int       @default(1) // WEEKLY: 0=Sunday .. 6=Saturday
  maxSteps      Int       @default(3) // PLAN_RUN: steps per fire (1..3)
  enabled       Boolean   @default(true)
  // DAILY_DIGEST delivery targets (beyond the studio's own digest
  // panel): an outbound webhook (POST the digest JSON) and an email
  // address (SMTP via nodemailer when ANIMEOS_SMTP_URL is set). Both
  // null = the digest lands in the studio only.
  webhookUrl    String?
  digestEmail   String?
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastStatus    String?   // OK | SKIPPED | ERROR (null = never fired)
  lastReport    String?   // what the last fire actually did
  runCount      Int       @default(0)
  createdAt     DateTime  @default(now())
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// USER-DEFINED ARC TEMPLATES (reusable beat shapes per production)
// ─────────────────────────────────────────────────────────────

// A creator-saved arc template: a sequence of segments
// (JSON [{frac, kind: "auto" | "state"}], fractions of the
// speaker's own lines in the range) painted onto a range by
// apply_arc_template or the Arc templates dialog, next to the
// built-in shapes. Two scopes: PROJECT templates belong to one
// production (that series' own beat vocabulary); STUDIO templates
// live in the studio library (projectId null) and are shared with
// EVERY production - a shape saved on one show is matchable and
// applicable on any other.
model ArcTemplate {
  id          String   @id @default(cuid())
  projectId   String?  // null for studio-library templates shared across productions
  scope       String   @default("PROJECT") // PROJECT | STUDIO
  name        String
  description String?
  segments    String   // JSON Array<{frac: number, kind: "auto" | "state"}>
  // Shape versioning: version counts the current shape (1 = as saved),
  // versions holds every REPLACED shape as JSON
  // [{version, segments, note, at}] newest-first, so an updated beat
  // shape never silently rewrites what earlier applies stamped.
  version     Int      @default(1)
  versions    String   @default("[]")
  // Usage counts per scope: how many times this shape was actually
  // APPLIED (a DSH apply or a dialog apply that stamped lines, one
  // count per batch for ensembles). No-op applies (nothing stamped)
  // never count, so the number stays an honest "this show really
  // uses this shape" signal alongside the scope tag.
  usageCount  Int      @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // DB-level uniqueness for production templates; studio templates
  // (projectId null) are deduped in the API because SQLite treats
  // NULLs as distinct in unique indexes.
  @@unique([projectId, name])
}

// ─────────────────────────────────────────────────────────────
// CREATOR-AUTHORED PLAN TEMPLATE VARIATIONS
// ─────────────────────────────────────────────────────────────

// A creator-authored variation of a per-episode plan template:
// the four built-ins (beat-breakdown, panel-pass, render-pass,
// canon-audit) are code; a variation is a SAVED row the creator
// authors in the plans panel (often cloned from a built-in and
// reshaped - fewer shots, a different audit target). Landing one
// resolves the same tokens the built-ins resolve ({episode},
// {latestScene}, {title}) against the REAL episode row, so a
// variation lands as a concrete, reviewable PROPOSED plan.
// projectId null = studio-library variation shared by every
// production, mirroring ArcTemplate's two scopes.
model PlanTemplate {
  id          String    @id @default(cuid())
  projectId   String?   // null for studio-library variations shared across productions
  baseId      String    @default("custom") // built-in id it was cloned from, or "custom"
  name        String
  summary     String
  cadenceHint String    @default("nightly - a few steps per fire")
  steps       String    @default("[]") // JSON Array<{tool, args, why}> with {episode}/{latestScene}/{title} tokens
  usageCount  Int       @default(0) // how many plans actually landed from this variation
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

// ─────────────────────────────────────────────────────────────
// IDENTITY-SIMILARITY SCORING FOR PANELS
// ─────────────────────────────────────────────────────────────

// How closely a shot's panel art matches each featured character's
// canonical model sheet, judged by a vision model and persisted per
// panel (one row per shot, replaced on re-score). scores is JSON:
// [{characterName, similarity 0..1, aspects {face, hair, wardrobe,
// weapon, palette, style}, note}]. worst is the lowest similarity in
// the row (the readout the identity panel and DSH rank by). A low
// worst feeds the re-paint offer next to the score.
model IdentityScore {
  id         String   @id @default(cuid())
  projectId  String
  shotId     String
  source     String   @default("PANEL") // PANEL (storyboard art) | RENDER (a frame from the finished clip)
  scores     String   @default("[]") // JSON IdentityScoreEntry[]
  worst      Float    @default(1) // min similarity across the panel's cast
  castSize   Int      @default(0) // how many anchored cast members were judged
  note       String?  // the vision model's one-line summary for the panel
  scoredAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  shot       Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([shotId, source])
}

// PROVIDER-FREE IDENTITY AFFINITY: a deterministic artwork-level
// embedding of each panel (64-bit dHash structure + 4x4x4 palette
// histogram) compared against the SAME embedding of every featured
// character's model sheet. A tripwire, not an identity verdict: it
// is instant, costs zero providers, and keeps a drift watch alive
// when the vision provider is rate-limited. The vision score stays
// the identity authority.
model PanelEmbedding {
  id         String   @id @default(cuid())
  projectId  String
  shotId     String   @unique
  hashHex    String // panel structure hash (64-bit dHash, hex)
  rows       String   @default("[]") // JSON [{characterName, palette, structure, blockStructure, blockPalette, combined, note}]
  worst      Float    @default(1) // min combined affinity across the panel's cast (higher = closer)
  method     String   @default("block-v1: 64-bit dHash + 3x3 block dHashes + global/quadrant 4x4x4 palette histograms, provider-free")
  meta       String? // JSON {blockHexes:[9 x 4-char hex]} - the panel's per-block hashes for audit
  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  shot       Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// MULTI-USER STUDIO (auth + roles)
// ─────────────────────────────────────────────────────────────

// A studio member. The workspace is shared (every signed-in member
// sees the same productions - a small team studio, not per-user
// silos) and the role gates WRITES: VIEWER is read-only, EDITOR can
// direct DSH and edit everything, OWNER additionally manages the
// roster itself (roles, membership). The FIRST account ever
// registered becomes OWNER automatically; everyone after registers
// as VIEWER and waits for an OWNER's promotion.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String // bcrypt hash (never leaves the server)
  role         String   @default("VIEWER") // OWNER | EDITOR | VIEWER
  lastSeenAt   DateTime? // bumped on each successful API auth (roster liveness)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  comments     Comment[]
  memberships  ProjectMembership[]
}

// ─────────────────────────────────────────────────────────────
// PER-PROJECT CREW SCOPING (Iteration 49: siloed productions)
//
// The workspace is no longer one shared room: a member sees
// exactly the productions whose crew they are on, and an OWNER
// sees EVERYTHING without a row - ownership is implicit, global
// and unconditional (the studio's administrator can never be
// blocked from any corner of the system).
//
// `craft` is the member's LENS on that production, not a
// permission: it drives which dashboard panels lead (DIRECTING /
// ART / VOICE / REVIEW). Writes stay gated by the global studio
// role; a VIEWER crew member still only reads and speaks.
// ─────────────────────────────────────────────────────────────
model ProjectMembership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  craft     String   @default("REVIEW") // DIRECTING | ART | VOICE | REVIEW
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// WORKPLACE THREADS (the studio with more than one person in it)
//
// Comment threads anchored to the production's own artifacts:
// EPISODE / SCENE / SHOT (a comic panel IS its shot) / TAKE (a
// voice take is an AudioCue row) / FACT. Every signed-in member
// may speak - VIEWERs write here and nowhere else - while
// resolving stays with the thread's author and EDITOR+.
// ─────────────────────────────────────────────────────────────
model Comment {
  id         String    @id @default(cuid())
  projectId  String
  anchorType String // EPISODE | SCENE | SHOT | TAKE | FACT
  anchorId   String
  authorId   String
  authorName String // snapshot at write time (threads read true even if the display name moves)
  body       String
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String? // user id of the resolver
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, anchorType, anchorId])
}
